{
	"schemaVersion": 1,
	"id": "smallhands",
	"version": "${version}",
	"name": "Smallhands",
	"description": "Make your hands or items Small or Bigger",
	"authors": [
		"Sallylabs.net"
	],
	"contact": {
		"homepage": "https://sallylabs.net/",
		"sources": "https://github.com/TheSuperFluffyCat/Smallhands",
		"issues": "https://github.com/TheSuperFluffyCat/Smallhands/issues"
	},
	"license": "Apache-2.0",
	"icon": "assets/smallhands/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.sallylabs.SmallhandsClient"
		],
		"modmenu": [
			"${modmenu_entrypoint}"
		]
	},
	"mixins": [
		"smallhands.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
